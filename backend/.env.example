# ==============================================================================
# NOTIVEXA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to backend/.env and configure your values.
# NEVER commit your actual .env file or credentials to Git.
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=development
PORT=5000

# Security (CRITICAL)
# In production, JWT_SECRET must be at least 32 cryptographically random characters
# Generate with: openssl rand -base64 32
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_32_chars_min

# Frontend URL for CORS Whitelisting
FRONTEND_URL=https://notivexa.onrender.com

# Database Connection (MongoDB)
# ------------------------------------------------------------------------------
# CLONED REPOSITORY ISOLATION:
# Anyone cloning this repository MUST provide their own database connection.
# Notivexa will NEVER connect a cloned instance to the developer's database.
#
# Option A - Local MongoDB (Default for local development):
#   mongodb://127.0.0.1:27017/notivexa
#
# Option B - Dedicated MongoDB Atlas Cluster (Required for production):
#   mongodb+srv://<db_username>:<db_password>@<your-cluster>.mongodb.net/notivexa?retryWrites=true&w=majority
#
# NOTE: In production (NODE_ENV=production), the server will fail safely and
# refuse to start if MONGODB_URI is missing or contains placeholder values.
MONGODB_URI=

# Optional: Local MongoDB URI override for development
DEV_MONGODB_URI=mongodb://127.0.0.1:27017/notivexa

# Autonomous Local Storage Fallback (Development Only)
# When set to true in development, allows testing with local JSON store if MongoDB is offline.
# In production, this is strictly disabled (false).
ALLOW_DEMO_MODE=false

# AI Model Provider Keys (At least one recommended for generation)
# 1. Google Gemini (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Groq AI (Free tier available at https://console.groq.com)
GROQ_API_KEY=

# 3. Anthropic Claude (Optional, paid tier at https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Audio / TTS Keys (Optional: High-speed Edge TTS is bundled and works free without keys)
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# File Upload Limits (in bytes; 1073741824 = 1 GB)
MAX_FILE_SIZE=1073741824

# Multilingual OCR Worker Concurrency
OCR_CONCURRENCY=2
