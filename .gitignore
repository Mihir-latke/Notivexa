# ==============================================================================
# NOTIVEXA GITIGNORE — STRICT CREDENTIAL & ASSET ISOLATION
# Prevents accidental commits of credentials, private user data, and production files
# ==============================================================================

# Dependencies
node_modules/
package-lock.json

# Environment variables & secrets (CRITICAL: NEVER COMMIT REAL KEYS)
.env
.env.*
*.env
**/.env
**/.env.*
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!backend/.env.example
!frontend/.env.example

# Secret keys, certificates and credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Cloud Deployment Specifications containing sensitive configuration
render.yaml

# User uploads and dynamic generated files (CRITICAL: USER DATA PRIVACY)
backend/uploads/**
!backend/uploads/
!backend/uploads/.gitkeep
!backend/uploads/docs/
!backend/uploads/docs/.gitkeep
!backend/uploads/generated/
!backend/uploads/generated/.gitkeep
!backend/uploads/pdfs/
!backend/uploads/pdfs/.gitkeep
!backend/uploads/audio/
!backend/uploads/audio/.gitkeep
!backend/uploads/video/
!backend/uploads/video/.gitkeep
!backend/uploads/images/
!backend/uploads/images/.gitkeep
!backend/uploads/classroom_bg.png
!backend/uploads/teacher_stock.mp4

# Persistent local store data (CRITICAL: PREVENTS CLONE ACCOUNT LEAKAGE)
backend/data/*.json
backend/data/**/*.json
!backend/data/.gitkeep
backend/data/ocr-cache/**
!backend/data/ocr-cache/.gitkeep
backend/data/ocr-lang-data/*.traineddata*
backend/data/ocr-lang-data/*.gz
!backend/data/ocr-lang-data/eng.traineddata
!backend/data/ocr-lang-data/.gitkeep

# Temporary / Scratch Test Files & Media Tests
backend/dummy.mp3
backend/test.mp3
backend/out.mp4
backend/test_*.pdf
backend/test_*.mp4
backend/temp_test.pdf
backend/fix_*.js
backend/check_models.js
backend/list_models.js
backend/assets/promo/*.mp4
backend/assets/promo/*.wav
frontend/fix_crash*.js
frontend/fix_crash*.cjs
frontend/patch_flash.js

# Production Builds
dist/
build/
*.local

# System & IDE files
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/
