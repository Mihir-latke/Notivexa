PORT=5000
NODE_ENV=development
# MongoDB Atlas Cloud URI (Recommended for cloud deployment and live users)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/notivexa?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Free AI API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Text-to-Speech Keys (Optional)
GOOGLE_TTS_API_KEY=your_google_tts_key_here
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# Translation (Optional)
GOOGLE_TRANSLATE_KEY=your_google_translate_key_here

MAX_FILE_SIZE=52428800
FRONTEND_URL=http://localhost:3000

