PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/notivexa
JWT_SECRET=notivexa_secret_2025
JWT_EXPIRES_IN=7d

# ── FREE AI (get instantly, no credit card) ───────────────
# Groq: console.groq.com → Sign up → API Keys → Create
GROQ_API_KEY=your_groq_key_here

# Google Gemini: aistudio.google.com → Get API Key
GEMINI_API_KEY=your_gemini_key_here

# Anthropic (paid, best quality): console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here

# ── FREE TEXT-TO-SPEECH ───────────────────────────────────
# Google TTS: console.cloud.google.com → Enable Cloud TTS API → Credentials
GOOGLE_TTS_API_KEY=your_google_tts_key_here

# ElevenLabs: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=your_elevenlabs_key_here

# ── FREE TRANSLATION ──────────────────────────────────────
# MyMemory: FREE, no key, auto-used for Hindi/Marathi/etc
# LibreTranslate: FREE self-hosted or libretranslate.com
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_KEY=your_key_here

MAX_FILE_SIZE=104857600
FRONTEND_URL=http://localhost:3000
