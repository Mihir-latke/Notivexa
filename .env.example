# ==============================================================================
# NOTIVEXA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure values before starting in production.
# ==============================================================================

# Core Runtime Configuration
NODE_ENV=production
PORT=5000

# Security (CRITICAL: In production, JWT_SECRET must be at least 16 random characters)
JWT_SECRET=replace_with_a_long_cryptographically_secure_random_string_32_chars_min

# Frontend URL for CORS Whitelisting
FRONTEND_URL=https://notivexa.onrender.com

# Database Connection (MongoDB Atlas)
# Format: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/notivexa?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Allow demo local JSON store even if MongoDB is absent (true/false)
ALLOW_DEMO_MODE=false

# AI Model Provider Keys (At least one recommended for rich autonomous generation)
# 1. Google Gemini (Free tier available at https://aistudio.google.com)
GEMINI_API_KEY=

# 2. Groq AI (Free tier available at https://console.groq.com)
GROQ_API_KEY=

# 3. Anthropic Claude (Optional, paid tier at https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Audio / TTS Keys (Optional: High-speed Edge TTS is bundled and works free without keys)
GOOGLE_TTS_API_KEY=
ELEVENLABS_API_KEY=

# File Upload Limits
MAX_FILE_SIZE=52428800
