# Backend Specific Gitignore
.env
.env.*
*.env
!.env.example

# Private user uploads
uploads/**
!uploads/
!uploads/.gitkeep
!uploads/docs/
!uploads/docs/.gitkeep
!uploads/generated/
!uploads/generated/.gitkeep
!uploads/pdfs/
!uploads/pdfs/.gitkeep
!uploads/audio/
!uploads/audio/.gitkeep
!uploads/video/
!uploads/video/.gitkeep
!uploads/images/
!uploads/images/.gitkeep
!uploads/classroom_bg.png
!uploads/teacher_stock.mp4

# Private local data
data/*.json
data/**/*.json
!data/.gitkeep
data/ocr-cache/**
!data/ocr-cache/.gitkeep
data/ocr-lang-data/*.traineddata*
data/ocr-lang-data/*.gz
!data/ocr-lang-data/eng.traineddata
!data/ocr-lang-data/.gitkeep

# Logs and scratch
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
test_*.pdf
test_*.mp4
temp_*.pdf
dummy.*
out.*

